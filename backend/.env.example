# ==============================================================================
# VARIABLES DE ENTORNO: SISTEMA SGR - ILUSTRE MUNICIPALIDAD DE LA SERENA
# ==============================================================================

# 1. Configuración básica de Django
# Genera una clave propia con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REEMPLAZA_POR_UNA_CLAVE_ALEATORIA_LARGA
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# 2. SQLite es la opción local predeterminada. Activa MySQL solo si ya está configurado.
USE_MYSQL=False
DB_NAME=matriz_sgr_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# 3. Almacenamiento de evidencias; usa la carpeta local media/ durante el desarrollo.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# 4. Orígenes adicionales; deja vacíos estos valores para una aplicación del mismo origen.
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# 5. Producción: configura HTTPS, cookies seguras y correo SMTP desde variables secretas.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
