# Copy to .env.ec2 on the EC2 instance and replace every example value.
SECRET_KEY='REPLACE_WITH_A_LONG_RANDOM_DJANGO_SECRET'
DEBUG=False
ALLOWED_HOSTS=REPLACE_WITH_EC2_PUBLIC_IP,localhost

USE_MYSQL=True
DB_NAME=matriz_sgr_db
DB_USER=sgr_user
DB_PASSWORD='REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD'
DB_ROOT_PASSWORD='REPLACE_WITH_A_DIFFERENT_RANDOM_ROOT_PASSWORD'
DB_HOST=db
DB_PORT=3306

# Use an S3 bucket and an EC2 IAM role for persistent private evidence files.
USE_S3=True
AWS_STORAGE_BUCKET_NAME=REPLACE_WITH_PRIVATE_S3_BUCKET_NAME
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# HTTP is for a restricted deployment smoke test only. Configure HTTPS before
# allowing real municipal or personal information through this application.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

APP_PORT=8000
